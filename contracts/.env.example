# Copy to .env and fill in — never commit the real .env file.

# Monad testnet RPC — confirm against https://docs.monad.xyz before deploying
# (testnet endpoints rotate). Public default:
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Deployer key — DO NOT use your main wallet. Prefer the monad-wallet Alchemy
# Agent Wallet flow over a raw private key where possible.
DEPLOYER_PRIVATE_KEY=

# Address that will submit verifications (oracle bridge's signer address).
ORACLE_ADDRESS=
