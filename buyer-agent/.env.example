# Copy to .env — never commit the real file.

# Monad testnet RPC (confirm against https://docs.monad.xyz — endpoints rotate)
RPC_URL=https://testnet-rpc.monad.xyz

# Deployed marketplace ("ComputeSLA") contract address
CONTRACT_ADDRESS=

# The agent's OWN wallet key — it signs its own transactions autonomously.
# Use a dedicated throwaway key funded with only what you're willing to let
# the agent spend. The maxTotalSpendWei cap is the software guardrail; a
# separate low-balance wallet is the hardware one.
AGENT_PRIVATE_KEY=
